server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Security headers (repeated in locations that set their own add_header,
    # since nginx doesn't inherit add_header into those blocks).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Container liveness probe (used by the Dockerfile HEALTHCHECK).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Resolve the backend hostname per request (via the container's DNS, filled
    # in by the image's entrypoint) rather than once at startup, so nginx still
    # boots when the backend is down and follows it if its IP changes.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # Reverse-proxy the Spring Boot API so the browser only ever talks to one
    # origin. The backend reads X-Forwarded-For for rate limiting.
    location /api/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_http_version 1.1;
        # $http_host (not $host) keeps the port, so Spring sees the same
        # host:port as the browser's Origin and treats calls as same-origin.
        # With $host, any non-80 port (e.g. localhost:3000) fails Spring's
        # CORS check with 403 "Invalid CORS request".
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite emits content-hashed filenames, so these can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # SPA fallback: unknown paths (/notes, /login, ...) serve index.html so
    # React Router can handle them. index.html itself is never cached, so a
    # new deploy is picked up on the next load.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
